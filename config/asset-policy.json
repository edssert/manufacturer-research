{
  "schemaVersion": 1,
  "runtimeAssets": {
    "root": "public/assets",
    "supportedExtensions": [
      ".avif",
      ".gif",
      ".ico",
      ".jpeg",
      ".jpg",
      ".otf",
      ".png",
      ".svg",
      ".ttf",
      ".webp",
      ".woff",
      ".woff2"
    ],
    "missingReferencesAllowed": 0,
    "orphanFilesAllowed": 0
  },
  "originalArchive": {
    "role": "official-source-archive",
    "location": "raw-data/raw-assets and raw-data/official-docs",
    "trackedInRepository": true,
    "storage": "git-lfs"
  },
  "normalization": {
    "defaultMode": "dry",
    "applyRequiresManifestReview": true,
    "formats": [".png", ".jpg", ".jpeg", ".webp"],
    "preserveOriginals": true,
    "presentationSurface": "#FFFFFF",
    "transparentPixelThreshold": 0.001,
    "whiteBorderThreshold": 0.9,
    "opaquePhotosAreCutoutCandidates": false,
    "officialShadowCompositionIsPreserved": true,
    "sourcedAssetsRequireHashManifest": true
  },
  "knownExactDuplicates": {
    "reviewStatus": "reviewed-same-brand-variant-aliases",
    "groups": 105,
    "files": 270,
    "recoverableBytes": 141615065,
    "automaticDeletionAllowed": false,
    "historyRewriteRequiresSeparateApproval": true
  }
}
