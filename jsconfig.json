{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "maxNodeModuleJsDepth": 0,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2024",
    "types": ["node"]
  },
  "include": [
    "public/js/bootstrap-preferences.js",
    "public/js/main.js",
    "public/js/core/manufacturers.js",
    "public/js/core/route-codec.js",
    "public/js/core/router.js",
    "public/js/domains/accessories/accessories.detail.js",
    "public/js/domains/amplifiers/amplifiers.configurations.js",
    "public/js/domains/amplifiers/amplifiers.detail.js",
    "public/js/domains/dsps/dsps.detail.js",
    "public/js/domains/software/software.detail.js",
    "public/js/domains/speakers/speakers.card-model.js",
    "public/js/domains/speakers/speakers.detail.js",
    "public/js/relationships/cross-ref.js",
    "public/js/relationships/detail-registry.js",
    "public/js/relationships/entity-registry.js",
    "public/js/ui/modal.js",
    "public/js/ui/pane-interactions.js",
    "public/js/ui/relation-navigation.js",
    "public/js/ui/split-view.js",
    "public/js/ui/sticky-header.js",
    "public/js/ui/toggle.js",
    "scripts/*.mjs",
    "public/tests/amplifier-configurations.test.mjs",
    "public/tests/entity-registry.test.mjs",
    "public/tests/relation-navigation.test.mjs",
    "public/tests/route-codec.test.mjs",
    "public/tests/speaker-card-model.test.mjs"
  ],
  "exclude": ["dist", "node_modules"]
}
